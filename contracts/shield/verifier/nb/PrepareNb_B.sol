    // The DEEP round (docs/15): a 19-bit grind under the query grind's rule, its nonce
    // absorbed on success, then 148 independent F_p^2 coefficients as one stream under
    // 0x9, in the launch's coefficient order. Then the FRI seed, as the launch draws it.
    function _deep(bytes32 state, uint64 nonce) private view returns (F.Fp2[] memory d, bytes32 seed) {
        TS.T memory t = TS.T(state);
        if (!TS.verifyPow(t, nonce, 19)) revert DeepGrindRejected();
        assembly {
            d := mload(0x40)
            mstore(d, 148)
            let ptr := add(d, 0x20)
            let cell := add(ptr, 0x1280)
            let end := add(cell, 0x2500)
            mstore(0x40, end)
            for { let c := cell } lt(c, end) { c := add(c, 0x40) } {
                mstore(ptr, c)
                ptr := add(ptr, 0x20)
            }
            let pre := end
            let s := mload(t)
            for {} lt(cell, end) {} {
                mstore8(pre, 0x9)
                mstore(add(pre, 1), s)
                s := keccak256(pre, 33)
                let v := s
                v := or(shr(8, and(v, 0xff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00)), shl(8, and(v, 0xff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff)))
                v := or(shr(16, and(v, 0xffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000)), shl(16, and(v, 0xffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff)))
                v := or(shr(32, and(v, 0xffffffff00000000ffffffff00000000ffffffff00000000ffffffff00000000)), shl(32, and(v, 0xffffffff00000000ffffffff00000000ffffffff00000000ffffffff)))
