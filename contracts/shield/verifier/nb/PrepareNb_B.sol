                    let w := and(shr(sh, v), 0xffffffffffffffff)
                    if lt(w, 0xffffffff00000001) {
                        mstore(cell, w)
                        cell := add(cell, 0x20)
                        if eq(cell, end) { break }
                    }
                    if iszero(sh) { break }
                }
            }
            mstore(t, s)
        }

        // With the mask pair opened as N = M_c + X M_{c+1}, the second column's coefficient is the
        // first's times X (RealQueryVerify._deepCoeffs).
        for (uint256 k = 0; k < 2; ++k) {
            uint256 i = k * 44 + 42;
            d[i + 1] = F.Fp2(mulmod(7, d[i].c1, F.P), d[i].c0);
        }
        TS.mix(t, 0x8, "");
        seed = t.state;
    }

    // docs/16: the shape bound before any query grind, state = keccak256(0x0A || state || id).
    function _bindShape(TS.T memory t) private pure {
        assembly {
            let pre := mload(0x40)
            mstore8(pre, 0xa)
            mstore(add(pre, 1), mload(t))
            mstore8(add(pre, 33), 0x3)
            mstore(t, keccak256(pre, 34))
