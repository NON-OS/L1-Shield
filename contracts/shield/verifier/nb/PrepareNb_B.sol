        bytes32[] memory roots = h.friRoots;
        F.Fp2[] memory betas = s.betas;
        uint256[] memory idx = s.friIdx;
        W.Base memory b = s.b;
        uint256[] memory kf = b.kflat;
        F.Fp2 memory z = s.ck.z;
